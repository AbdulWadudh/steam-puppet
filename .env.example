# Optional. The server reads the account name from the token that setup.ts
# cached in bin/config/config.vdf. Only set this if more than one account is
# cached and you need to pick one.
# STEAM_USERNAME=your_steam_username

# Where packed mods land, as <target>/<Title>/<Version>/<Title>.
MOD_TARGET_DIR=G:\GAMES\CK3_MODS

# WebSocket port. Must match SERVER_PORT at the top of client.js.
WS_PORT=8090
